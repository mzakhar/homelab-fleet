loki.source.journal "kitchen_hub" {
  path       = "/var/log/journal"
  max_age    = "336h"
  labels     = {host = "kitchen-hub", service_name = "kitchen-hub"}
  forward_to = [loki.write.homelab.receiver]
}

loki.write "homelab" {
  endpoint {
    url = "http://192.168.1.3:30310/loki/api/v1/push"
  }
}
